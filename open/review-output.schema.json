{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sealgrowth.cn/open/review-output.schema.json",
  "title": "海豹增长 自带密钥评审工具输出 review-output-v1",
  "description": "网页工具 V1 要求模型输出的 JSON。六个维度顺序固定；档位 unknown/weak/normal/strong/na；字数为上限（按字符计）。方法见 METHOD-V3.md，提示词见 prompt-v1.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "summary", "axes", "premises", "gates", "next_steps", "requests", "questions", "caveats"],
  "properties": {
    "version": {"const": "review-output-v1"},
    "summary": {"type": "string", "maxLength": 60, "description": "一句话定位与阶段"},
    "axes": {
      "type": "array", "minItems": 6, "maxItems": 6, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/axis", "properties": {"name": {"const": "市场需求"}}},
        {"$ref": "#/$defs/axis", "properties": {"name": {"const": "商业模式"}}},
        {"$ref": "#/$defs/axis", "properties": {"name": {"const": "资本效率"}}},
        {"$ref": "#/$defs/axis", "properties": {"name": {"const": "竞争壁垒"}}},
        {"$ref": "#/$defs/axis", "properties": {"name": {"const": "执行能力"}}},
        {"$ref": "#/$defs/axis", "properties": {"name": {"const": "投资回报"}}}
      ]
    },
    "premises": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {"$ref": "#/$defs/premise"},
      "contains": {"type": "object", "properties": {"critical": {"const": true}}, "required": ["critical"]},
      "minContains": 1
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["fraud", "tech", "cash", "integrity", "note"],
      "properties": {
        "fraud": {"$ref": "#/$defs/gate_state"},
        "tech": {"$ref": "#/$defs/gate_state"},
        "cash": {"$ref": "#/$defs/gate_state"},
        "integrity": {"$ref": "#/$defs/gate_state"},
        "note": {"type": "string", "maxLength": 200}
      }
    },
    "next_steps": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/next_step"}, "description": "先便宜后贵"},
    "requests": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 30}},
    "questions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/question"}},
    "caveats": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 60}}
  },
  "$defs": {
    "tier": {"enum": ["unknown", "weak", "normal", "strong", "na"]},
    "gate_state": {"enum": ["unchecked", "pass", "block"]},
    "axis": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "suggested", "agree", "reason", "public_reason", "next", "missing"],
      "properties": {
        "name": {"enum": ["市场需求", "商业模式", "资本效率", "竞争壁垒", "执行能力", "投资回报"]},
        "suggested": {"$ref": "#/$defs/tier", "description": "模型的归档建议；填表人已选档位时仍须填写"},
        "agree": {"type": ["boolean", "null"], "description": "填表人已选档位：是否同意；未选：null"},
        "reason": {"type": "string", "maxLength": 100},
        "public_reason": {"type": "string", "maxLength": 24, "description": "给创始人看的一句理由"},
        "next": {"type": "string", "maxLength": 60, "description": "下一步要证明什么；弱点与未知必填，其余可为空字符串"},
        "missing": {"type": "string", "maxLength": 40}
      },
      "if": {"properties": {"suggested": {"enum": ["unknown", "weak"]}}},
      "then": {"properties": {"next": {"minLength": 1}}}
    },
    "premise": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "status", "critical", "why"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 40},
        "status": {"enum": ["verified", "partial", "unverified", "false"]},
        "critical": {"type": "boolean"},
        "why": {"type": "string", "maxLength": 60}
      }
    },
    "next_step": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "verify", "by", "pass"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 60},
        "verify": {"type": "string", "maxLength": 22},
        "by": {"type": "string", "maxLength": 6},
        "pass": {"type": "string", "maxLength": 12}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["q", "good", "red"],
      "properties": {
        "q": {"type": "string", "minLength": 1, "maxLength": 60},
        "good": {"type": "string", "maxLength": 40},
        "red": {"type": "string", "maxLength": 40}
      }
    }
  }
}
